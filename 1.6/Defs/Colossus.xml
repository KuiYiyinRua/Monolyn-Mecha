<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <BodyPartDef>
    <defName>MM_ColossusHull</defName><label>Colossus chassis</label><hitPoints>300</hitPoints>
    <permanentInjuryChanceFactor>0</permanentInjuryChanceFactor><skinCovered>false</skinCovered><solid>true</solid><alive>false</alive><bleedRate>0</bleedRate>
    <tags><li>ConsciousnessSource</li><li>MovingLimbCore</li><li>MovingLimbSegment</li><li>MovingLimbDigit</li><li>ManipulationLimbCore</li><li>ManipulationLimbSegment</li><li>ManipulationLimbDigit</li><li>SightSource</li><li>HearingSource</li><li>BloodPumpingSource</li><li>BreathingSource</li><li>MetabolismSource</li></tags>
  </BodyPartDef>
  <BodyDef><defName>MM_ColossusBody</defName><label>Colossus chassis</label><corePart><def>MM_ColossusHull</def><height>Middle</height><depth>Outside</depth></corePart></BodyDef>
  <ThingDef ParentName="BasePawn">
    <defName>MM_Colossus</defName><label>Colossus</label><thingClass>Monolyn.Mecha.Pawn_Colossus</thingClass>
    <description>A four-legged warframe piloted by one colonist for ranged fire support. Twin beams sweep across the target area and can fire while moving. Walls block the beams, and friendly units can be hit.\n\nOccupies 3×3 cells and moves through walls and obstacles at 8 cells per second without terrain penalties. Carries 800 kg and can be ridden in caravans. Runs on light; it can teleport with its pilot within the light network on the same map.</description>
    <size>(3,3)</size><uiIconPath>Things/Mecha/Colossus/Colossus_south</uiIconPath><soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <graphicData><texPath>Things/Mecha/Colossus/Colossus</texPath><graphicClass>Graphic_Multi</graphicClass><drawSize>(3.6,5.6)</drawSize><drawOffset>(0,0,1.1)</drawOffset></graphicData>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints><MoveSpeed>8</MoveSpeed><Mass>900</Mass><CarryingCapacity>800</CarryingCapacity>
      <MarketValue>14500</MarketValue><Flammability>0</Flammability><PainShockThreshold>999</PainShockThreshold>
      <ArmorRating_Sharp>1.00</ArmorRating_Sharp><ArmorRating_Blunt>0.77</ArmorRating_Blunt><ArmorRating_Heat>2</ArmorRating_Heat>
      <PsychicSensitivity>0</PsychicSensitivity><ToxicResistance>1</ToxicResistance><ComfyTemperatureMin>-100</ComfyTemperatureMin><ComfyTemperatureMax>250</ComfyTemperatureMax>
      <MeatAmount>0</MeatAmount><LeatherAmount>0</LeatherAmount><FilthRate>0</FilthRate><Wildness>0</Wildness>
      <CaravanRidingSpeedFactor>1.6</CaravanRidingSpeedFactor><BandwidthCost MayRequire="Ludeon.RimWorld.Biotech">0</BandwidthCost>
    </statBases>
    <race>
      <intelligence>Animal</intelligence><body>MM_ColossusBody</body><fleshType>Mechanoid</fleshType>
      <baseBodySize>3</baseBodySize><baseHealthScale>1</baseHealthScale><lifeExpectancy>2500</lifeExpectancy><hasGenders>false</hasGenders>
      <needsRest>false</needsRest><foodType>None</foodType><packAnimal>true</packAnimal><trainability>None</trainability>
      <canBePredatorPrey>false</canBePredatorPrey><bloodDef>Filth_MachineBits</bloodDef><thinkTreeMain>MM_ImmortalThink</thinkTreeMain><renderTree>Animal</renderTree>
      <lifeStageAges><li><def>MM_ImmortalFullyFormed</def><minAge>0</minAge></li></lifeStageAges>
    </race>
    <tools><li><label>blade legs</label><capacities><li>Blunt</li></capacities><power>12</power><cooldownTime>2</cooldownTime></li></tools>
    <comps>
      <li Class="ASEL.CompProperties_LightStorage"><maxLight>10000</maxLight></li>
      <li Class="Monolyn.Mecha.CompProperties_MechaLightReceiver"><minLighttoRecive>1</minLighttoRecive><targetOffset>(0,0.5,0)</targetOffset></li>
      <li Class="ASEL.CompProperties_LightConsumer"/>
      <li Class="CompProperties_ProjectileInterceptor">
        <radius>2.2</radius><interceptGroundProjectiles>true</interceptGroundProjectiles><interceptNonHostileProjectiles>false</interceptNonHostileProjectiles><interceptOutgoingProjectiles>false</interceptOutgoingProjectiles>
        <color>(0.6,0.6,0.6)</color><idlePulseSpeed>3</idlePulseSpeed><minIdleAlpha>0.05</minIdleAlpha>
        <chargeDurationTicks>1800</chargeDurationTicks><disarmedByEmpForTicks>100</disarmedByEmpForTicks><activeSound>Broadshield_Ambience</activeSound>
        <hitPoints>100</hitPoints><rechargeHitPointsIntervalTicks>180</rechargeHitPointsIntervalTicks><alwaysShowHitpointsGizmo>true</alwaysShowHitpointsGizmo>
      </li>
      <li Class="ASEL.CompProperties_PhaseShield"/>
      <li MayRequire="Ludeon.RimWorld.Biotech" Class="CompProperties_MechRepairable"/>
    </comps>
    <butcherProducts><MNCalcirite>150</MNCalcirite><MNPneumaCircuit>3</MNPneumaCircuit></butcherProducts>
    <researchPrerequisites><li>MM_ColossusResearch</li></researchPrerequisites>
  </ThingDef>
  <PawnKindDef>
    <defName>MM_Colossus</defName><label>Colossus</label><race>MM_Colossus</race><combatPower>650</combatPower><isFighter>true</isFighter><canArriveManhunter>false</canArriveManhunter>
    <lifeStages><li><bodyGraphicData><texPath>Things/Mecha/Colossus/Colossus</texPath><graphicClass>Graphic_Multi</graphicClass><drawSize>(3.6,5.6)</drawSize><drawOffset>(0,0,1.1)</drawOffset></bodyGraphicData></li></lifeStages>
  </PawnKindDef>
  <DamageDef>
    <defName>MM_ColossusBeam</defName><label>Colossus beam</label><workerClass>DamageWorker_AddInjury</workerClass><externalViolence>true</externalViolence>
    <deathMessage>{0} was killed by a Colossus beam.</deathMessage><hediff>MNBeamWound</hediff><armorCategory>Sharp</armorCategory><isRanged>true</isRanged><makesAnimalsFlee>true</makesAnimalsFlee>
    <defaultDamage>12</defaultDamage><defaultArmorPenetration>0.6</defaultArmorPenetration><buildingDamageFactor>1</buildingDamageFactor><buildingDamageFactorImpassable>1</buildingDamageFactorImpassable><buildingDamageFactorPassable>1</buildingDamageFactorPassable>
  </DamageDef>
  <ResearchProjectDef>
    <defName>MM_ColossusResearch</defName><label>Colossus warframe</label><description>Unlocks construction of the Colossus, a four-legged warframe that crosses obstacles and sweeps enemies with twin beams while moving.</description>
    <tab>MonolynAE</tab><knowledgeCategory>Information</knowledgeCategory><knowledgeCost>28000</knowledgeCost>
    <prerequisites><li>MM_ImmortalResearch</li><li>MNGravityControl</li></prerequisites><researchViewX>10</researchViewX><researchViewY>0</researchViewY>
  </ResearchProjectDef>
  <ASEL.MonolynRecipeDef ParentName="MechRecipeBase">
    <defName>MM_PrintColossus</defName><label>Build: Colossus</label><thing>MM_Colossus</thing><pawnKindDef>MM_Colossus</pawnKindDef>
    <description>Build a Colossus at a construct formator linked to a mechanitor. It crosses obstacles and fires twin beams while moving. Uses no bandwidth.</description>
    <recipeTime>240000</recipeTime><lightCost>50000</lightCost><costList><MNCalcirite>300</MNCalcirite><MNPneumaCircuit>6</MNPneumaCircuit><MN_Seed>50</MN_Seed></costList>
    <researchPrerequisites><li>MM_ColossusResearch</li></researchPrerequisites>
    <ingredients>
      <li><filter><thingDefs><li>MNCalcirite</li></thingDefs></filter><count>300</count></li>
      <li><filter><thingDefs><li>MNPneumaCircuit</li></thingDefs></filter><count>6</count></li>
      <li><filter><thingDefs><li>MN_Seed</li></thingDefs></filter><count>50</count></li>
    </ingredients><products><MM_Colossus>1</MM_Colossus></products>
  </ASEL.MonolynRecipeDef>
</Defs>
